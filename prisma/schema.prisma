generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum ProjectStatus { PLANNING ACTIVE WAITING_CLIENT WAITING_AGENCY SUSPENDED COMPLETED CANCELLED }
enum TaskStatus { TODO IN_PROGRESS REVIEW DONE BLOCKED }
enum OpportunityStatus { NEW CONTACTED QUALIFICATION MEETING QUOTE PROPOSAL NEGOTIATION WON LOST }
enum ReceivableStatus { TO_ISSUE OPEN OVERDUE COLLECTION PAID CANCELLED }

model User { id String @id @default(cuid()); name String; email String @unique; role String @default("MEMBER"); hourlyCost Decimal @default(0) @db.Decimal(10,2); projects ProjectMember[]; tasks Task[]; timeEntries TimeEntry[]; createdAt DateTime @default(now()) }
model Client { id String @id @default(cuid()); name String; document String?; phone String?; email String?; properties Property[]; opportunities Opportunity[]; projects Project[]; createdAt DateTime @default(now()) }
model Property { id String @id @default(cuid()); name String; municipality String?; registration String?; areaHa Decimal?; clientId String; client Client @relation(fields:[clientId], references:[id], onDelete:Cascade); projects Project[]; opportunities Opportunity[]; createdAt DateTime @default(now()); @@index([clientId]) }
model Opportunity { id String @id @default(cuid()); title String; service String?; source String?; estimatedValue Decimal? @db.Decimal(14,2); probability Int @default(0); status OpportunityStatus @default(NEW); nextContact DateTime?; clientId String?; propertyId String?; client Client? @relation(fields:[clientId], references:[id]); property Property? @relation(fields:[propertyId], references:[id]); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([clientId]); @@index([propertyId]) }
model Project { id String @id @default(cuid()); code String @unique; name String; service String?; status ProjectStatus @default(PLANNING); priority String @default("MEDIUM"); startDate DateTime?; dueDate DateTime?; contractedValue Decimal? @db.Decimal(14,2); taxRate Decimal @default(15.5) @db.Decimal(5,2); clientId String; propertyId String?; client Client @relation(fields:[clientId], references:[id]); property Property? @relation(fields:[propertyId], references:[id]); members ProjectMember[]; wbsItems WbsItem[]; tasks Task[]; processes AdministrativeProcess[]; receivables Receivable[]; invoices Invoice[]; expenses Expense[]; createdAt DateTime @default(now()); @@index([clientId]); @@index([propertyId]) }
model ProjectMember { projectId String; userId String; role String?; project Project @relation(fields:[projectId], references:[id]); user User @relation(fields:[userId], references:[id]); @@id([projectId,userId]); @@index([userId]) }
model WbsTemplate { id String @id @default(cuid()); name String @unique; service String?; description String?; items WbsTemplateItem[]; createdAt DateTime @default(now()) }
model WbsTemplateItem { id String @id @default(cuid()); code String; title String; parentCode String?; plannedHours Decimal? @db.Decimal(8,2); plannedCost Decimal? @db.Decimal(14,2); sortOrder Int @default(0); templateId String; template WbsTemplate @relation(fields:[templateId], references:[id], onDelete:Cascade); @@index([templateId]) }
model WbsItem { id String @id @default(cuid()); code String; title String; parentId String?; projectId String; plannedHours Decimal? @db.Decimal(8,2); plannedCost Decimal? @db.Decimal(14,2); startDate DateTime?; endDate DateTime?; progress Int @default(0); project Project @relation(fields:[projectId], references:[id]); parent WbsItem? @relation("WbsTree", fields:[parentId], references:[id]); children WbsItem[] @relation("WbsTree"); tasks Task[]; predecessors WbsDependency[] @relation("WbsSuccessor"); successors WbsDependency[] @relation("WbsPredecessor"); @@index([parentId]); @@index([projectId]) }
model Task { id String @id @default(cuid()); title String; status TaskStatus @default(TODO); priority String @default("MEDIUM"); startDate DateTime?; dueDate DateTime?; estimatedHours Decimal? @db.Decimal(8,2); projectId String; wbsItemId String?; assigneeId String?; project Project @relation(fields:[projectId], references:[id]); wbsItem WbsItem? @relation(fields:[wbsItemId], references:[id]); assignee User? @relation(fields:[assigneeId], references:[id]); timeEntries TimeEntry[]; @@index([projectId]); @@index([wbsItemId]); @@index([assigneeId]) }
model TimeEntry { id String @id @default(cuid()); hours Decimal @db.Decimal(8,2); note String?; date DateTime @default(now()); taskId String; userId String; task Task @relation(fields:[taskId], references:[id]); user User @relation(fields:[userId], references:[id]); @@index([taskId]); @@index([userId]) }
model AdministrativeProcess { id String @id @default(cuid()); agency String; processNumber String?; subject String; status String; protocolDate DateTime?; deadline DateTime?; projectId String; project Project @relation(fields:[projectId], references:[id]); @@index([projectId]) }
model Receivable { id String @id @default(cuid()); description String; amount Decimal @db.Decimal(14,2); dueDate DateTime; paidAt DateTime?; status ReceivableStatus @default(OPEN); projectId String; project Project @relation(fields:[projectId], references:[id]); @@index([projectId]) }
model Invoice { id String @id @default(cuid()); number String?; issueDate DateTime; grossAmount Decimal @db.Decimal(14,2); taxRate Decimal @db.Decimal(5,2); taxAmount Decimal @db.Decimal(14,2); netAmount Decimal @db.Decimal(14,2); status String @default("ISSUED"); projectId String; project Project @relation(fields:[projectId], references:[id]); @@index([projectId]) }
model Expense { id String @id @default(cuid()); description String; category String; amount Decimal @db.Decimal(14,2); date DateTime; status String @default("PAID"); projectId String; project Project @relation(fields:[projectId], references:[id]); @@index([projectId]) }
model WbsDependency { id String @id @default(cuid()); predecessorId String; successorId String; predecessor WbsItem @relation("WbsPredecessor", fields:[predecessorId], references:[id], onDelete:Cascade); successor WbsItem @relation("WbsSuccessor", fields:[successorId], references:[id], onDelete:Cascade); @@unique([predecessorId, successorId]); @@index([successorId]) }
model Notification { id String @id @default(cuid()); title String; body String?; kind String @default("INFO"); dueAt DateTime?; readAt DateTime?; userId String?; createdAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()); actorId String?; actorName String?; action String; entityType String; entityId String?; summary String; metadata Json?; createdAt DateTime @default(now()); @@index([entityType, entityId]); @@index([createdAt]) }
